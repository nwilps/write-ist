# Tests read it from $WRITE_IST_CORPUS and skip when it is absent.
test/fixtures/script.fountain

# Rust build output and the capability schemas Tauri generates from
# src-tauri/capabilities. Both are derived; neither is edited.
src-tauri/target/
src-tauri/gen/
